+        }
+        for ($i = 0; $i < $f693Steps; $i++) {
+            echo "PROBE-PLAN step " . $f693PlainRow[$i] . " | " . $f693PlanRow[$i] . "\n";
+        }
+        $f693Delta = $f693PlanTrim - $f693PlainTrim;
+        $f693Pct = ($f693PlainTrim > 0.0) ? round(100.0 * $f693Delta / $f693PlainTrim, 1) : 0.0;
+        if ($f693WalkEq == 1) {
